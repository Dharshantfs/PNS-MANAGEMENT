rules_version = '2';

// Security rules for the PG management app's Firestore database.
//
// IMPORTANT - please review and test this in the Firebase Console's Rules
// Playground before relying on it in production. It was written to match
// the app's current data model (see src/types.ts and
// src/services/firestoreService.ts) but has not been tested against a live
// project from this environment.
//
// The public tenant onboarding page (TenantOnboardingForm.tsx) no longer
// writes `tenants` or `rooms` from the browser - new residents, KYC, Aadhaar
// photos and tenant logins all go through the server (api/_lib/app.ts
// /api/onboard/*, Admin SDK, which bypasses these rules). So creating a
// tenant or changing a room's beds is owner/staff-only below.
//
// kycDocuments (Aadhaar photos) intentionally has no rule at all: Firestore
// denies anything without a matching rule, so browsers can never read it -
// only the server routes can.
//
// This file is published automatically on every Vercel deploy
// (scripts/deployFirestoreRules.ts) - edit it here, never in the Console.
//
// Admin/staff accounts are invite-only (see server/app.ts
// POST /api/admin/create-team-member) - there is no public sign-up. An
// invited account's users/{uid} profile lists which properties it can
// access (`propertyIds`), which is what "owns" a property for rules
// purposes below, not just the original creator's uid.
service cloud.firestore {
match /databases/{database}/documents {

  function isSignedIn() {
    return request.auth != null;
  }

  function callerProfile() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
  }

  // A property is accessible either to the account that directly created it
  // (its own `ownerId` field - checked here so the creator's access never
  // depends on their users/{uid} profile being separately kept in sync,
  // which the client is intentionally not allowed to do - see the users/{uid}
  // rule below) or to an invited team member listed in their own profile's
  // `propertyIds` (set server-side only, at invite time).
  function isOwnerOfProperty(propertyId) {
    return isSignedIn() && (
      get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid ||
      propertyId in callerProfile().propertyIds
    );
  }

  // Property/business SETTINGS (room types, sharing options, dues packages,
  // agreement templates, rent due day, etc.) are owner-only - a "staff" role
  // account can run day-to-day operations (rooms/tenants/payments/notices/
  // tickets, all still gated by isOwnerOfProperty above) but not reconfigure
  // the property itself or invite more team members (that's also enforced
  // server-side in server/app.ts's create-team-member endpoint).
  function isOwnerRole() {
    return isSignedIn() && callerProfile().role == 'owner';
  }

  // Owner/staff profile. The account may read/update its own profile, but
  // NOT its own `role` or `propertyIds` - those are only ever set by the
  // Admin SDK (server/app.ts, which bypasses rules), preventing a staff
  // account from self-promoting to owner or granting itself other
  // properties. `mustChangePassword` and `name` remain self-editable.
  match /users/{uid} {
    allow read: if isSignedIn() && request.auth.uid == uid;
    allow create: if false; // only the Admin SDK creates profiles
    allow update: if isSignedIn() && request.auth.uid == uid &&
      request.resource.data.role == resource.data.role &&
      request.resource.data.propertyIds == resource.data.propertyIds;
  }

  // Properties: readable by anyone (needed for the public onboarding page to
  // show room types/sharing options before the visitor is signed in).
  // Only the owning account may create/update/delete its own property.
  match /properties/{propertyId} {
    allow read: if true;
    allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    allow update, delete: if isOwnerOfProperty(propertyId) && isOwnerRole();

    match /counters/{counterId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }

  // Rooms: readable by anyone (needed to show vacant beds during public
  // onboarding). Writes are owner/staff-only; public onboarding allocates
  // beds server-side.
  match /rooms/{roomId} {
    allow read: if true;
    // `resource` doesn't exist yet on a create - it must be checked against
    // `request.resource` (the incoming document), not `resource` (the prior
    // one), otherwise every create is silently denied.
    allow create: if isOwnerOfProperty(request.resource.data.propertyId);
    allow delete: if isOwnerOfProperty(resource.data.propertyId);
    allow update: if isOwnerOfProperty(resource.data.propertyId);
  }

  // Tenants: hold PII/KYC data, so reads are locked down more than
  // properties/rooms. A tenant may read/update only their own document
  // (matched by their signed-in phone number); the owner may read/update any
  // tenant on their own property. Public onboarding is allowed to `create`
  // a new tenant document (see the trade-off note above) and `get` a single
  // document by exact phone match (findTenantByPhone uses an exact-match
  // query, not a collection scan, so this doesn't expose the whole list).
  match /tenants/{tenantId} {
    allow get: if true;
    // Owner/staff list their own property's tenants (Tenant Directory,
    // dashboard counts); everyone else may only run the single-result
    // phone lookup. The owner check comes first so a full-list query never
    // depends on the `limit` comparison (null when no limit is set).
    allow list: if isOwnerOfProperty(resource.data.propertyId) || request.query.limit <= 1;
    allow create: if isOwnerOfProperty(request.resource.data.propertyId);
    allow update: if isOwnerOfProperty(resource.data.propertyId) ||
      (isSignedIn() && request.auth.token.phone_number == resource.data.phone);
    allow delete: if isOwnerOfProperty(resource.data.propertyId);
  }

  // Payments: owner has full access to their property's payments. A tenant
  // may create a payment report for themself (see PGContext.payRentAsTenant)
  // but cannot mark it 'paid' - only the owner can (confirmPendingPayment).
  match /payments/{paymentId} {
    allow read: if isOwnerOfProperty(resource.data.propertyId) ||
      (isSignedIn() &&
        get(/databases/$(database)/documents/tenants/$(resource.data.tenantId)).data.phone == request.auth.token.phone_number);
    allow create: if isOwnerOfProperty(request.resource.data.propertyId) || isSignedIn();
    allow update, delete: if isOwnerOfProperty(resource.data.propertyId);
  }

  // Notices & maintenance tickets: owner manages fully; any signed-in tenant
  // on the property can read notices and create/read their own tickets.
  match /notices/{noticeId} {
    allow read: if true;
    allow write: if isOwnerOfProperty(request.resource.data.propertyId) ||
      isOwnerOfProperty(resource.data.propertyId);
  }

  match /tickets/{ticketId} {
    allow read: if isSignedIn();
    allow create: if isSignedIn();
    allow update, delete: if isOwnerOfProperty(resource.data.propertyId);
  }

  // Dues charges (Settings > Dues Packages, added via Financial Reports >
  // Add Dues): owner-only, both to create and to read/manage. Unlike
  // payments, a tenant never creates or needs to read these directly.
  match /charges/{chargeId} {
    allow read: if isOwnerOfProperty(resource.data.propertyId);
    allow create: if isOwnerOfProperty(request.resource.data.propertyId);
    allow update, delete: if isOwnerOfProperty(resource.data.propertyId);
  }

  // Activity log (Owner > Activity Log): records what staff/co-owner accounts
  // did in the app. Owner-only to read (so staff can't see each other's/the
  // owner's full history); any owner/staff account with property access may
  // append an entry alongside the action it describes (see PGContext's
  // `logActivity`). Immutable once written - no update/delete rule, and the
  // one server-side writer (api/_lib/app.ts team invite) uses the Admin SDK,
  // which bypasses these rules entirely.
  match /activityLogs/{logId} {
    allow read: if isOwnerOfProperty(resource.data.propertyId) && isOwnerRole();
    allow create: if isOwnerOfProperty(request.resource.data.propertyId);
  }
}
}
