rules_version = '2';

// Security rules for the PG management app's Firestore database.
//
// This file is published automatically on every Vercel deploy
// (scripts/deployFirestoreRules.ts) - edit it here, never in the Console.
//
// Who is who:
// - Owner / staff: email+password accounts with a users/{uid} profile
//   (created only by the Admin SDK - bootstrap script or Settings > Team
//   Access). They reach a property either by creating it (its `ownerId`) or
//   by being invited to it (their profile's `propertyIds`).
// - Tenant: email+password account created by POST /api/onboard/tenant-login
//   with custom claims { role: 'tenant', tenantId }. Older phone-OTP tenant
//   accounts are matched by their verified phone number instead.
// - Signed-out visitors (invite links, self-registration) never read or
//   write Firestore directly any more - everything they need goes through
//   the server (api/_lib/app.ts /api/onboard/*), which checks the invite
//   token and returns only non-sensitive fields.
//
// Collections with no rule at all are server-only (Admin SDK bypasses
// rules): kycDocuments (Aadhaar photos and full Aadhaar numbers),
// propertySecrets (webhook keys).
service cloud.firestore {
match /databases/{database}/documents {

  function isSignedIn() {
    return request.auth != null;
  }

  function tokenTenantId() {
    return request.auth.token.get('tenantId', '');
  }

  // Only a phone number proven by an SMS sign-in counts. Email/password
  // accounts can carry any phone number, so it proves nothing.
  function tokenPhone() {
    return request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'phone'
      ? request.auth.token.get('phone_number', '')
      : '';
  }

  function isTenantAccount() {
    return isSignedIn() && request.auth.token.get('role', '') == 'tenant' && tokenTenantId() != '';
  }

  // An owner/staff account: signed in, not a tenant login, and has a
  // users/{uid} profile (only the Admin SDK can create one).
  function isStaff() {
    return isSignedIn() &&
      request.auth.token.get('role', '') != 'tenant' &&
      exists(/databases/$(database)/documents/users/$(request.auth.uid));
  }

  function callerProfile() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
  }

  // A property is accessible to the account that created it (its own
  // `ownerId`) or to an invited team member listed in their profile's
  // `propertyIds` (set server-side only, at invite time).
  function isOwnerOfProperty(propertyId) {
    return isStaff() && (
      get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid ||
      propertyId in callerProfile().get('propertyIds', [])
    );
  }

  // Property SETTINGS are owner-role only; staff run day-to-day operations.
  function isOwnerRole() {
    return isStaff() && callerProfile().role == 'owner';
  }

  // Full Aadhaar numbers are kept only in the server-only kycDocuments
  // collection. A tenant record may hold an empty number, or keep the one
  // it already had (older records, until the daily housekeeping moves it) -
  // never a new full number.
  function aadhaarIn(data) {
    return data.get('kyc', {}).get('aadhaar', {}).get('aadhaarNumber', '');
  }
  function noNewAadhaarNumber() {
    return aadhaarIn(request.resource.data) == '' ||
      (resource != null && aadhaarIn(request.resource.data) == aadhaarIn(resource.data));
  }

  // The signed-in tenant's own tenant document.
  function myTenant() {
    return get(/databases/$(database)/documents/tenants/$(tokenTenantId())).data;
  }

  // Is `tenantId` the signed-in tenant? By claim, or (older phone-OTP
  // accounts) by the tenant document's phone matching the verified phone.
  function isTenantSelf(tenantId) {
    return isSignedIn() && (
      (tokenTenantId() != '' && tokenTenantId() == tenantId) ||
      (tokenPhone() != '' &&
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.phone == tokenPhone())
    );
  }

  // Does the signed-in tenant live in `propertyId`?
  function isTenantOfProperty(propertyId) {
    return isTenantAccount() && myTenant().propertyId == propertyId;
  }

  // Owner/staff profile. The account may read/update its own profile, but
  // NOT its own `role` or `propertyIds` - those are only ever set by the
  // Admin SDK, preventing self-promotion to owner.
  match /users/{uid} {
    allow read: if isSignedIn() && request.auth.uid == uid;
    allow create: if false; // only the Admin SDK creates profiles
    allow update: if isSignedIn() && request.auth.uid == uid &&
      request.resource.data.role == resource.data.role &&
      request.resource.data.propertyIds == resource.data.propertyIds;
  }

  // Properties: readable only by the property's owner/staff and by its own
  // tenants (the tenant portal shows its name / UPI id). Signed-out pages
  // (invite links, self-registration) get the name from the server instead.
  match /properties/{propertyId} {
    allow get: if isOwnerOfProperty(propertyId) || isTenantOfProperty(propertyId);
    allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    allow create: if isStaff() && request.resource.data.ownerId == request.auth.uid;
    allow update, delete: if isOwnerOfProperty(propertyId) && isOwnerRole();

    // Receipt-number counter - only owner/staff issue receipts.
    match /counters/{counterId} {
      allow read, write: if isOwnerOfProperty(propertyId);
    }
  }

  // Rooms: owner/staff of the property; a tenant may read only the room
  // they live in. (Public onboarding gets vacant-room options from the
  // server, without any resident names.)
  match /rooms/{roomId} {
    allow get: if isOwnerOfProperty(resource.data.propertyId) ||
      (isTenantAccount() && myTenant().get('roomId', '') == roomId);
    allow list: if isOwnerOfProperty(resource.data.propertyId);
    allow create: if isOwnerOfProperty(request.resource.data.propertyId);
    allow update: if isOwnerOfProperty(resource.data.propertyId) &&
      request.resource.data.propertyId == resource.data.propertyId;
    allow delete: if isOwnerOfProperty(resource.data.propertyId);
  }

  // Tenants hold KYC / Aadhaar data: readable only by owner/staff of the
  // property and by the tenant themself.
  match /tenants/{tenantId} {
    allow get: if isOwnerOfProperty(resource.data.propertyId) || isTenantSelf(tenantId);
    // Owner/staff list their property's tenants; an older phone-OTP tenant
    // account may look up its own record by its verified phone number.
    allow list: if isOwnerOfProperty(resource.data.propertyId) ||
      (isSignedIn() && tokenPhone() != '' && resource.data.phone == tokenPhone());
    allow create: if isOwnerOfProperty(request.resource.data.propertyId) && noNewAadhaarNumber();
    // Only owner/staff write tenant records directly. A tenant (re)submits
    // their KYC through the server (POST /api/onboard/kyc), which always
    // sets it to 'pending' and keeps the Aadhaar number server-side.
    allow update: if isOwnerOfProperty(resource.data.propertyId) &&
      request.resource.data.propertyId == resource.data.propertyId &&
      noNewAadhaarNumber();
    allow delete: if isOwnerOfProperty(resource.data.propertyId);
  }

  // Payments: owner/staff manage them. A tenant may read their own and
  // report a UPI payment for themself - only as 'pending', for their own
  // property. Only owner/staff can confirm it (mark it 'paid').
  match /payments/{paymentId} {
    allow read: if isOwnerOfProperty(resource.data.propertyId) || isTenantSelf(resource.data.tenantId);
    allow create: if isOwnerOfProperty(request.resource.data.propertyId) ||
      (isTenantAccount() &&
        request.resource.data.tenantId == tokenTenantId() &&
        request.resource.data.propertyId == myTenant().propertyId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.get('receiptNumber', '') == '' &&
        request.resource.data.get('purpose', 'rent') == 'rent' &&
        request.resource.data.get('verificationSource', 'manual') == 'manual' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0);
    allow update: if isOwnerOfProperty(resource.data.propertyId) &&
      request.resource.data.propertyId == resource.data.propertyId;
    allow delete: if isOwnerOfProperty(resource.data.propertyId);
  }

  // Notices: owner/staff manage; tenants of the property read them.
  match /notices/{noticeId} {
    allow read: if isOwnerOfProperty(resource.data.propertyId) || isTenantOfProperty(resource.data.propertyId);
    allow create: if isOwnerOfProperty(request.resource.data.propertyId);
    allow update: if isOwnerOfProperty(resource.data.propertyId) &&
      request.resource.data.propertyId == resource.data.propertyId;
    allow delete: if isOwnerOfProperty(resource.data.propertyId);
  }

  // Maintenance tickets: owner/staff see all of their property's tickets;
  // a tenant sees and raises only their own.
  match /tickets/{ticketId} {
    allow read: if isOwnerOfProperty(resource.data.propertyId) || isTenantSelf(resource.data.tenantId);
    allow create: if isOwnerOfProperty(request.resource.data.propertyId) ||
      (isTenantAccount() &&
        request.resource.data.tenantId == tokenTenantId() &&
        request.resource.data.propertyId == myTenant().propertyId &&
        request.resource.data.status == 'Open');
    allow update: if isOwnerOfProperty(resource.data.propertyId) &&
      request.resource.data.propertyId == resource.data.propertyId;
    allow delete: if isOwnerOfProperty(resource.data.propertyId);
  }

  // Dues charges: owner/staff create and manage; a tenant can read their own.
  match /charges/{chargeId} {
    allow read: if isOwnerOfProperty(resource.data.propertyId) || isTenantSelf(resource.data.tenantId);
    allow create: if isOwnerOfProperty(request.resource.data.propertyId);
    allow update: if isOwnerOfProperty(resource.data.propertyId) &&
      request.resource.data.propertyId == resource.data.propertyId;
    allow delete: if isOwnerOfProperty(resource.data.propertyId);
  }

  // Activity log: owner-role read; any owner/staff account with property
  // access may append. Immutable once written.
  match /activityLogs/{logId} {
    allow read: if isOwnerOfProperty(resource.data.propertyId) && isOwnerRole();
    allow create: if isOwnerOfProperty(request.resource.data.propertyId);
  }
}
}
