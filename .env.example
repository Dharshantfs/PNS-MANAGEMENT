# Firebase client config (Auth, Firestore) is already checked in at
# firebase-applet-config.json and needs no env vars - Firebase's client API
# key is safe to expose in frontend code, access is governed by
# firestore.rules, not by keeping this value secret.

# Firebase Admin SDK service account - required to run `npm run bootstrap-owner`
# (creates the first admin login - see scripts/bootstrapFirstOwner.ts) and for
# Settings > Team Access (inviting further admin/staff accounts), the
# KYC / invite-link endpoints and `npm run kyc-housekeeping`. Generate one at:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Meta WhatsApp Cloud API (WhatsApp dues reminders & KYC-invite messages -
# NOT used for login, that's Firebase phone-auth). Until all of these are set
# the app shows the message for the owner to copy and send by hand.
# Token: a permanent System User token with whatsapp_business_messaging
# (Meta Business Settings > System users) - the 24h test token expires.
META_WA_TOKEN=
# WhatsApp Manager > Phone numbers > Phone number ID (not the phone number)
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v21.0
META_WA_TEMPLATE_LANG=en
# Approved template names. Body variables must be in this order:
#   rent reminder: {{1}} tenant name, {{2}} PG name, {{3}} amount due
#   KYC invite:    {{1}} tenant name, {{2}} room number, {{3}} KYC link
META_WA_TEMPLATE_RENT_REMINDER=
META_WA_TEMPLATE_KYC_INVITE=

# Secret for the daily "automatic monthly rent" job (vercel.json crons ->
# GET /api/cron/monthly-rent). Vercel sends it as "Authorization: Bearer
# <CRON_SECRET>". Any long random string; without it the job refuses to run.
CRON_SECRET=

# Firebase App Check (blocks bots on the public sign-up / KYC-link endpoints).
# 1. Firebase Console > App Check > register the web app with reCAPTCHA v3 and
#    copy the SITE key into VITE_RECAPTCHA_SITE_KEY (frontend, build-time).
# 2. Deploy, check the public form and Tenant Portal KYC still work.
# 3. Then set APP_CHECK_ENFORCE=1 (server) so requests without a valid App
#    Check token are refused. Setting it before step 1 breaks the public forms.
VITE_RECAPTCHA_SITE_KEY=
APP_CHECK_ENFORCE=

# Reserved for later: Cashfree Payment Gateway + Aadhaar Verification keys.
# Not wired up yet - payments and KYC are manual/owner-reviewed until these
# are configured. See types.ts PaymentVerificationSource / KYCVerificationMethod.
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
