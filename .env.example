# Firebase client config (Auth, Firestore, Storage) is already checked in at
# firebase-applet-config.json and needs no env vars - Firebase's client API
# key is safe to expose in frontend code, access is governed by
# firestore.rules, not by keeping this value secret.

# Firebase Admin SDK service account - only needed for the server-side Google
# Forms bulk-admission endpoints in server.ts (everything else talks to
# Firestore directly from the browser). Generate one at:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Twilio Keys (for WhatsApp dues reminders & KYC-invite messages - NOT used
# for login anymore, that's real Firebase phone-auth now)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Reserved for later: Cashfree Payment Gateway + Aadhaar Verification keys.
# Not wired up yet - payments and KYC are manual/owner-reviewed until these
# are configured. See types.ts PaymentVerificationSource / KYCVerificationMethod.
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
